{
  "name": "smart-canteen-enterprise-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "智慧食堂企业级 Web MVP：学生端、管理端、规则推荐与可迁移领域层。",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:collector": "vite --config collector-web/vite.config.js --host 0.0.0.0",
    "dev:api": "node server/index.js",
    "dev:collector-api": "node collector-server/index.js",
    "dev:full": "node scripts/dev-full.js",
    "build": "vite build",
    "build:collector": "vite build --config collector-web/vite.config.js",
    "build:miniapp": "npm --prefix miniapp run build:mp-weixin",
    "generate:campus-kb": "node scripts/generate-campus-dining-corpus.mjs",
    "generate:campus-challenges": "node scripts/generate-campus-dining-challenges.mjs",
    "generate:rag-simulation": "node scripts/generate-rag-simulation.mjs",
    "generate:multi-source-eval": "node scripts/generate-multi-source-evaluation.mjs",
    "validate:campus-kb": "node scripts/validate-campus-dining-corpus.mjs",
    "validate:knowledge-kb": "node scripts/validate-knowledge-base.mjs",
    "check:knowledge-sources": "node scripts/check-knowledge-sources.mjs",
    "sync:food-references": "node scripts/sync-food-composition-references.mjs",
    "generate:dish-annotations": "node scripts/generate-dish-ai-annotations.mjs",
    "generate:catalog-introductions": "node scripts/generate-catalog-introductions.mjs",
    "eval:knowledge-kb": "node scripts/evaluate-knowledge-retrieval.mjs",
    "eval:multi-source": "node scripts/evaluate-multi-source-retrieval.mjs",
    "eval:embedding-ab": "node scripts/evaluate-embedding-ab.mjs",
    "eval:grounded-answers": "node scripts/evaluate-grounded-agent-answers.mjs",
    "eval:rag-local": "node scripts/evaluate-local-retrieval.mjs",
    "eval:rag-simulation": "node scripts/evaluate-rag-simulation.mjs",
    "catalog:promote:pg": "node scripts/promote-real-catalog-postgres.mjs",
    "catalog:introductions:import:pg": "node scripts/import-catalog-introductions-postgres.mjs",
    "catalog:introductions:revalidate:pg": "node scripts/revalidate-catalog-introductions-postgres.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "pilot:hash-phone": "node scripts/hash-pilot-phone.mjs",
    "collector:staff": "node scripts/bootstrap-collector-staff.mjs",
    "collector:export": "node scripts/export-collector-dataset.mjs",
    "collector:train": "node scripts/train-collector-model.mjs",
    "collector:deploy": "node scripts/deploy-collector-model.mjs",
    "collector:smoke-dataset": "node scripts/create-collector-smoke-dataset.mjs",
    "collector:smoke-model": "python scripts/create-tiny-siglip-fixture.py",
    "trace:rag-requests": "node scripts/trace-rag-requests.mjs",
    "perf:k6": "node scripts/run-k6.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/run-tests.mjs",
    "test:postgres-rls": "node --test tests/postgres-rls.integration.test.mjs",
    "test:collector-ui": "node scripts/capture-collector-ui.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "@vitejs/plugin-vue": "latest",
    "busboy": "^1.6.0",
    "pg": "8.13.0",
    "pinia": "latest",
    "sharp": "^0.35.3",
    "vite": "latest",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "latest"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "ioredis": "^5.4.0"
  }
}
