# Smart Canteen production-style environment
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
SMART_CANTEEN_TIME_ZONE=Asia/Shanghai

# REQUIRED in production. Use a long random value; it signs JWTs and encrypts AI keys.
SMART_CANTEEN_SECRET=replace-with-at-least-32-random-bytes

# Database
# SQLite is for local development and unit tests only.
SMART_CANTEEN_DB=/app/data/smart-canteen.sqlite
VISION_EMBEDDING_BASE_URL=
VISION_EMBEDDING_MODEL=siglip-base-patch16-224
VISION_EMBEDDING_DIMENSION=768
VISION_EMBEDDING_TIMEOUT_MS=8000
VISION_AUTO_MATCH_ENABLED=0

# PostgreSQL production roles. Keep these three URLs separate in production.
# Passwords embedded in URLs must be URL-encoded.
DB_DRIVER=postgres
DB_MIGRATE=0
DATABASE_MIGRATION_URL=postgres://smart_canteen_migrator:change-me@postgres:5432/smart_canteen
DATABASE_URL=postgres://smart_canteen_api:change-me@postgres:5432/smart_canteen
DATABASE_WORKER_URL=postgres://smart_canteen_worker:change-me@postgres:5432/smart_canteen

# Docker Compose bootstrap credentials and container-local URLs.
POSTGRES_DB=smart_canteen
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-admin
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_API_PASSWORD=change-me-api
POSTGRES_WORKER_PASSWORD=change-me-worker
DOCKER_DATABASE_MIGRATION_URL=postgres://smart_canteen_migrator:change-me-migrator@postgres:5432/smart_canteen
DOCKER_DATABASE_URL=postgres://smart_canteen_api:change-me-api@postgres:5432/smart_canteen
DOCKER_DATABASE_WORKER_URL=postgres://smart_canteen_worker:change-me-worker@postgres:5432/smart_canteen

# Host-only ports. Override these when running an isolated release-candidate
# stack beside another local Compose project.
POSTGRES_PORT=55432
API_PORT=8787
WEB_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL pool and query limits. The API pool defaults are sized for the
# current small VPS; increase only after observing pool wait and database load.
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_POOL_ACQUIRE_TIMEOUT_MS=5000
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_MAX_LIFETIME_SECONDS=1800
PG_STATEMENT_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=12000
PG_IDLE_TRANSACTION_TIMEOUT_MS=15000
PG_APPLICATION_NAME=smart-canteen-api

# Cache
REDIS_URL=redis://redis:6379
REDIS_REQUIRED=1
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=2000
MEMORY_CACHE_MAX_ENTRIES=2000

# Transactional Outbox worker
OUTBOX_WORKER_ENABLED=1
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_TIMEOUT_MS=60000
OUTBOX_MAX_ATTEMPTS=8

# Private upload storage. Persistent references use upload://<id>; clients read
# content through authenticated or short-lived signed /api/uploads/:id/content.
UPLOAD_DIR=/app/uploads
UPLOAD_URL_TTL_SECONDS=900

# S3 / MinIO object storage. Set S3_BUCKET to enable the S3 adapter.
S3_BUCKET=smart-canteen-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=smart-canteen
S3_SECRET_ACCESS_KEY=change-me-minio-secret

# Runtime security and operations
ALLOW_LEGACY_STATELESS_TOKENS=0
TRUSTED_PROXY_CIDRS=172.16.0.0/12
INTERNAL_METRICS_TOKEN=replace-with-a-long-random-metrics-token
SHUTDOWN_TIMEOUT_MS=15000
LOG_INTERNAL_ERRORS=0

# Optional OpenAI-compatible chat defaults. Admin UI settings override chat per tenant.
AI_CHAT_BASE_URL=https://opencode.ai/zen/go/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=deepseek-v4-flash
AI_CHAT_TIMEOUT_MS=12000
AI_ROUTING_TIMEOUT_MS=3000
AI_VISION_MODEL=gpt-4o-mini

# Local embedding experiment. Keep RETRIEVAL_VECTOR_MODE=off in production until
# the final embedding model and PostgreSQL vector dimension have been selected.
AI_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_EMBEDDING_DIMENSION=1024
AI_EMBEDDING_TIMEOUT_MS=30000
AI_EMBEDDING_BATCH_SIZE=24
RETRIEVAL_VECTOR_MODE=off

# Legacy single-provider variables remain supported for existing deployments.
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=12000

# Closed-pilot controls. Production defaults to `team` when PILOT_MODE is omitted.
# `invite` accepts only SHA-256/HMAC phone lookup hashes, never plain mobile numbers.
PILOT_MODE=team
PILOT_ALLOWED_PHONE_HASHES=
PILOT_DISABLED_FEATURES=community_write,review_write
CURRENT_AGREEMENT_VERSION=2026-07

# Registration options: sms (default) or invitation. Invitation registration
# creates a password account but does not prove ownership of the mobile number.
PILOT_REGISTRATION_MODE=sms

# SMS verification. `SMS_TEST_CODE` is honoured only when NODE_ENV=test.
# The webhook adapter is for an approved internal SMS gateway; select and add a
# provider-specific adapter before using a third-party SMS service directly.
SMS_PROVIDER=disabled
SMS_WEBHOOK_URL=
SMS_WEBHOOK_AUTHORIZATION=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_TIMEOUT_MS=8000

# WeChat Mini Program login. Required only when enabling POST /api/auth/wechat-login.
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=
WECHAT_LOGIN_TIMEOUT_MS=8000
